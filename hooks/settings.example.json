{
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON>",
            "args": [
              "-X",
              "utf8",
              "<SKILL_DIR>/scripts/handoff_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "<PYTHON>",
            "args": [
              "-X",
              "utf8",
              "<SKILL_DIR>/scripts/handoff_hook.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
